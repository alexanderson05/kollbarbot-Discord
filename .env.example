# Bot token: Discord Developer Portal > your app > Bot > Reset Token
DISCORD_TOKEN=
# Channel IDs (Developer Mode on > right-click channel > Copy Channel ID)
WELCOME_CHANNEL_ID=
TICKET_LOG_CHANNEL_ID=
# Staff role IDs that can see tickets, comma-separated
TICKET_STAFF_ROLE_IDS=
# Optional GIF URL for welcome/ticket embeds (leave empty to disable)
WELCOME_GIF_URL=
# Text shown as the bot's "Playing ..." status
BOT_STATUS=kollbar bot
